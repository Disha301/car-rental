            color: antiquewhite;
            border-radius: 12px;
            display: block;
            margin: 0 auto;
            text-align: center;
            font-size: medium;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <h2>Your Booking Has Been Confirmed</h2>
    <h1>Reservation Confirmation</h1>
