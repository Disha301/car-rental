<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Bookings</title>
  <link rel="stylesheet" href="/admin-bookings.css">
</head>
<body>

<h2>All Bookings</h2>

<table border="2" cellpadding="10">
  <tr>
    <th>Customer</th>
    <th>Destination</th>
    <th>Contact</th>
    <th>Total Cost</th>
  </tr>

  <% bookings.forEach(b => { %>
    <tr>
      <td><%= b.customerName %></td>
      <td><%= b.destination %></td>
      <td><%= b.contact %></td>
      <td>₹<%= b.totalCost %></td>
    </tr>
  <% }) %>

</table>

<br>
<a href="/admin/dashboard">⬅ Back to Dashboard</a>

</body>
</html>
