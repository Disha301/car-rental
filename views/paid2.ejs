<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Status</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      background: #9cc0e3;
      font-family: 'Segoe UI', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .status-container {
      background: white;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.1);
      max-width: 400px;
      text-align: center;
      animation: fadeIn 1s ease-out;
    }

    .status-icon {
      font-size: 60px;
      margin-bottom: 20px;
      color: <%= booking.paymentStatus === 'SUCCESS' ? '#28a745' : '#dc3545' %>;
      animation: bounceIn 0.6s ease-in-out;
    }

    h1 {
      font-size: 28px;
      margin: 0 0 10px;
      color: #333;
    }

    p {
      color: #555;
      font-size: 16px;
      margin-bottom: 10px;
    }

    a.button {
      display: inline-block;
      background: #007bff;
      color: #fff;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      margin-top: 15px;
      transition: background 0.3s ease;
    }

    a.button:hover {
      background: #0056b3;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes bounceIn {
      0% { transform: scale(0.5); opacity: 0; }
      60% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>
  <div class="status-container">
    <div class="status-icon">
      <%= booking.paymentStatus === 'SUCCESS' ? '✅' : '❌' %>
    </div>
    <h1><%= booking.paymentStatus === 'SUCCESS' ? 'Payment Successful' : 'Payment Failed' %></h1>

    <p><strong>Customer:</strong> <%= booking.customerName %></p>
    <p><strong>Car:</strong> <%= booking.carId %></p>
    <p><strong>Days:</strong> <%= booking.days %></p>
    <p><strong>Total Cost:</strong> $<%= booking.totalCost %></p>

    <% if (booking.paymentStatus === 'SUCCESS') { %>
      <p><strong>Receipt ID:</strong> <%= booking.receiptId %></p>
      <p>A confirmation email will be sent shortly.</p>
    <% } else { %>
      <p>Please try again or contact support.</p>
    <% } %>

    <a href="/" class="button">Back to Home</a>
  </div>
</body>
</html>