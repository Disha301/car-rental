<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=<device-width>, initial-scale=1.0">
    <title>Document</title>
    <style>
       body{
          background-color: aqua;
       }
        h1,h2{
            font-size: 3rem;
            text-align: center;
            padding: 3%;
